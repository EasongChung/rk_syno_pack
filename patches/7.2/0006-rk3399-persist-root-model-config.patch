--- usr/syno/sbin/rk3399_sync_root.sh	1970-01-01 08:00:00.000000000 +0800
+++ usr/syno/sbin/rk3399_sync_root.sh	2026-06-11 00:00:00.000000000 +0800
@@ -0,0 +1,39 @@
+#!/bin/sh
+
+RootMnt="$1"
+
+[ -n "$RootMnt" ] || exit 0
+[ -d "$RootMnt" ] || exit 0
+
+set_synoinfo_kv()
+{
+	local file="$1"
+	local key="$2"
+	local value="$3"
+	local tmp="${file}.rk3399.$$"
+
+	[ -f "$file" ] || return 0
+
+	/bin/grep -v "^${key}=" "$file" > "$tmp" 2>/dev/null
+	echo "${key}=\"${value}\"" >> "$tmp"
+	/bin/mv -f "$tmp" "$file"
+}
+
+sync_model_config()
+{
+	local max_disks
+	local dir
+
+	max_disks="$(/bin/get_key_value /etc.defaults/synoinfo.conf maxdisks)"
+	[ -n "$max_disks" ] || max_disks=6
+
+	for dir in etc.defaults etc; do
+		[ -d "$RootMnt/$dir" ] || continue
+		[ -f "/$dir/model.dtb" ] && /bin/cp -f "/$dir/model.dtb" "$RootMnt/$dir/model.dtb"
+		set_synoinfo_kv "$RootMnt/$dir/synoinfo.conf" maxdisks "$max_disks"
+		set_synoinfo_kv "$RootMnt/$dir/synoinfo.conf" max_sys_raid_disks "$max_disks"
+	done
+}
+
+sync_model_config
+exit 0
